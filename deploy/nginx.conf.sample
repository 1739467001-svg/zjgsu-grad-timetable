# 浙工商研究生课表浏览器 · Nginx 站点配置示例
# 用法：把本文件内容并入 /etc/nginx/nginx.conf 的 http{} 段，
#      或放入 /etc/nginx/conf.d/kb.conf 后 nginx -s reload。
# 目录约定：/var/www/kb/ 下放 index.html、manifest.webmanifest、icon.svg 三个文件。

server {
    listen 80;
    server_name _;              # 有域名就改成域名，否则保持 _

    root /var/www;
    index index.html;

    # 课表应用入口：/kb/ 下所有路径都回落到 index.html（纯前端单页）
    location /kb/ {
        try_files $uri $uri/ /kb/index.html;
    }

    # PWA 资源缓存一周
    location ~* \.(webmanifest|svg)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # 可选：gzip 压缩（index.html 内嵌全部课程数据，约 300KB，压缩后传输约 80KB）
    gzip on;
    gzip_types text/html text/css application/manifest+json image/svg+xml;
}
